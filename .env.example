# Copy to apps/web/.env.local and fill in.
# Leave the LLM unset to run against the deterministic mock (demo chips only).

LLM_PROVIDER=anthropic          # anthropic | mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# --- Live Disqover data source (optional) ---
# When DISQOVER_URL is set, the app queries your Disqover instance instead of
# the demo CSV. Run this LOCALLY — your machine can reach the instance and your
# token never leaves it. Grab the bearer token from your logged-in session
# (browser DevTools -> Network -> any /api/query/v1.1 request -> Authorization
# header, the part after "Bearer ").
DISQOVER_URL=                   # e.g. https://disqover-dq7.aws-dev.disqover.com
DISQOVER_TOKEN=                 # JWT access token (sent as Authorization: Bearer ...)
# DISQOVER_COOKIE=              # alternative: raw Cookie header if it uses session cookies
# DISQOVER_VERSION=4.2          # configuration schema version
